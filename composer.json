{
    "name": "adamb/postio",
    "description": "UK postcode to address lookup on the Postio API (https://postio.co.uk), with county resolution and a drop-in replacement for adamb/afd",
    "keywords": ["Postio", "postcode", "address lookup", "PAF", "UK", "county"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Adam Binnersley",
            "email": "abinnersley@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": ">=7.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-redis": "Required for Postio\\Cache\\RedisCache"
    },
    "autoload": {
        "psr-4": {
            "Postio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Postio\\Tests\\": "tests/"
        }
    }
}
